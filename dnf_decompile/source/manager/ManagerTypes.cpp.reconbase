double CUnixTimer::GetNowTime()
{
    struct timeval tv;
    gettimeofday(&tv, 0);
    return tv.tv_sec + tv.tv_usec / 1000000.0;
}

double CUnixTimer::GetTimeInterval()
{
    return GetNowTime() - m_lastTime;
}

