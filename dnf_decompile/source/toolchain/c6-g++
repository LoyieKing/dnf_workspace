#!/bin/sh
# CentOS 6.10 (vault) gcc-4.4.7 包装脚本，用于对齐原始二进制（GCC 4.1.2/4.4.x 时代）。
# 工具链从 vault.centos.org/6.10/os/x86_64/Packages 的 RPM 解包到 /tmp/c6root；
# 解包 RPM 列表见 docs/df_community_r_reverification.md 或本目录 README（如有）。
# /tmp/c6root 重启后失效，重建时需重新解包。
# 根目录：优先 $DNF_TC_ROOT/c6root，回退 /tmp/c6root（bootstrap_toolchain.sh 生成）。
C6ROOT="${DNF_TC_ROOT:+$DNF_TC_ROOT/c6root}"; C6ROOT="${C6ROOT:-/tmp/c6root}"
export GCC_EXEC_PREFIX="$C6ROOT/usr/libexec/gcc/"
export LD_LIBRARY_PATH="$C6ROOT/usr/lib64:$C6ROOT/usr/lib"
exec "$C6ROOT/usr/bin/g++" "$@"
